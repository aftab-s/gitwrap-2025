# Copy to .env.local for local dev; set the same names in Vercel → Project → Settings → Environment Variables.
# None of these are VITE_-prefixed, so NONE of them are bundled into browser code.
# They are read only by the server functions in /api.

# Shared token for public (signed-out) lookups. A classic PAT with NO scopes is enough.
GITHUB_APP_TOKEN=

# --- "Sign in with GitHub" (optional; leave empty to hide sign-in) ---
# GitHub → Settings → Developer settings → OAuth Apps → New OAuth App
#   Authorization callback URL: <your site>/api/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Random 32+ character string used to encrypt the session cookie.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# --- Optional ---
# AI one-liner on the card (falls back to a built-in template when neither is set)
# 1. Gemini (primary)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash-lite
# 2. Groq (fallback or alternative)
GROQ_API_KEY=
# GROQ_MODEL=qwen/qwen3.8-27b
# Force the public origin used for the OAuth redirect (normally auto-detected)
# APP_URL=https://gitwrap-2026.vercel.app
