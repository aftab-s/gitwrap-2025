# Copy to .env.local for local dev; set the same names in Vercel → Project → Settings → Environment Variables.
# None of these are VITE_-prefixed, so NONE of them are bundled into browser code.
# They are read only by the server functions in /api.

# -----------------------------------------------------------------------------
# 1. GitHub API Access (Required for public lookups)
# -----------------------------------------------------------------------------
# Shared token for public (signed-out) lookups. A classic GitHub Personal Access Token
# (PAT) with NO scopes is sufficient (grants 5,000 req/hr instead of 60 req/hr).
GITHUB_APP_TOKEN=

# -----------------------------------------------------------------------------
# 2. "Sign in with GitHub" (Optional; enables private repo contribution counting)
# -----------------------------------------------------------------------------
# GitHub → Settings → Developer settings → OAuth Apps → New OAuth App
#   Application name: GitWrap 2026
#   Homepage URL: http://localhost:3000 (or your production domain)
#   Authorization callback URL: http://localhost:3000/api/auth/callback (or <your site>/api/auth/callback)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Random 32+ character string used to encrypt the AES-256-GCM session cookie.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# -----------------------------------------------------------------------------
# 3. AI Fun One-Liner (Optional; falls back to deterministic template if unset)
# -----------------------------------------------------------------------------
# Provider 1: Google Gemini (Primary)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash-lite

# Provider 2: Groq (Fallback or alternative)
GROQ_API_KEY=
# GROQ_MODEL=qwen/qwen3.8-27b

# -----------------------------------------------------------------------------
# 4. Deployment Overrides (Optional)
# -----------------------------------------------------------------------------
# Force the public origin used for OAuth redirection (auto-detected by default)
# APP_URL=https://gitwrap-2026.vercel.app

# Optional repository to query for the live community contributors shelf (defaults to aftab-s/gitwrap-2026)
# VITE_GITHUB_REPOSITORY=aftab-s/gitwrap-2026
